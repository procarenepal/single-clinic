# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_PASSWORD_RESET_DOMAIN=https://your-domain.netlify.app

# Billing backend (billing-backend/) — optional, defaults to http://localhost:8080/api/billing
VITE_BILLING_API_URL=http://localhost:8080/api/billing

# Appwrite Configuration
# Get these values from your Appwrite console at https://cloud.appwrite.io/console
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-appwrite-project-id
VITE_APPWRITE_BUCKET_ID=your-bucket-id

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. For Appwrite:
#    - Create a project at https://cloud.appwrite.io/console
#    - Get your project ID from the project settings
#    - Create a storage bucket named "your-bucket-id" (or use your preferred name)
#    - Update the bucket ID in the environment variable
# 4. For Firebase:
#    - Get your config from Firebase console project settings
#    - Replace all firebase values with your actual credentials
# Homepage content is keyed by clinic; the SMS gateway is optional (see VITE_SMS_FORCE_DIRECT).VITE_HOMEPAGE_CLINIC_ID=VITE_SMS_API_URL=VITE_SMS_API_KEY=VITE_SMS_SENDER_ID=VITE_SMS_ROUTE_ID=VITE_SMS_CAMPAIGN=